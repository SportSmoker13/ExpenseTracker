generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}
enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
  TRANSFER
}

enum SourceType {
  BANK
  CREDIT_CARD
  CASH
  OTHER
}

model Category {
  id           String          @id @default(cuid())
  userId       String
  name         String
  type         TransactionType
  colorCode    String?
  icon         String?
  transactions Transaction[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Float
  date        DateTime        @default(now())
  type        TransactionType
  description String?

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  source     Source?  @relation("FromSource", fields: [sourceId], references: [id])
  sourceId   String?

  toSource   Source?  @relation("ToSource", fields: [toSourceId], references: [id])
  toSourceId String?

  person     Person?  @relation(fields: [personId], references: [id])
  personId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([userId])
}

model Source {
  id           String          @id @default(cuid())
  userId       String
  name         String
  type         SourceType      @default(BANK)
  icon         String?
  balance      Float           @default(0)
  
  transactions     Transaction[] @relation("FromSource")
  toTransactions   Transaction[] @relation("ToSource")
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
}

model Person {
  id           String          @id @default(cuid())
  userId       String
  name         String
  transactions Transaction[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
}
